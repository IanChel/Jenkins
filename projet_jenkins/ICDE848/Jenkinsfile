pipeline {
    agent any

    tools {
        maven 'Maven_3'
        jdk 'JDK_21'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('projet_jenkins/ICDE848') {
                    script {
                        if (isUnix()) {
                            sh 'mvn clean compile -B'
                        } else {
                            bat 'mvn clean compile -B'
                        }
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('projet_jenkins/ICDE848') {
                    script {
                        if (isUnix()) {
                            sh 'mvn test -B'
                        } else {
                            bat 'mvn test -B'
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Jacoco') {
            steps {
                dir('projet_jenkins/ICDE848') {
                    script {
                        if (isUnix()) {
                            sh 'mvn verify -B -DskipTests'
                        } else {
                            bat 'mvn verify -B -DskipTests'
                        }
                    }
                }
            }
            post {
                always {
                    jacoco(
                        execPattern: '**/target/jacoco.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java'
                    )
                }
            }
        }

        stage('SpotBugs') {
            steps {
                dir('projet_jenkins/ICDE848') {
                    script {
                        if (isUnix()) {
                            sh 'mvn spotbugs:check -B'
                        } else {
                            bat 'mvn spotbugs:check -B'
                        }
                    }
                }
            }
            post {
                always {
                    recordIssues(tools: [spotBugs(pattern: '**/spotbugsXml.xml')])
                }
            }
        }

        stage('Checkstyle') {
            steps {
                dir('projet_jenkins/ICDE848') {
                    script {
                        if (isUnix()) {
                            sh 'mvn checkstyle:checkstyle -B -Dcheckstyle.config.location=checkstyle.xml'
                        } else {
                            bat 'mvn checkstyle:checkstyle -B -Dcheckstyle.config.location=checkstyle.xml'
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true, artifacts: '**/target/checkstyle-result.xml'
                }
            }
        }
    }

    post {
        failure {
            mail(
                to: 'chel65520@gmail.com',
                subject: "Build Failed: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                body: "Le build a échoué. Vérifie la console ici : ${env.BUILD_URL}"
            )
        }
        fixed {
            mail(
                to: 'chel65520@gmail.com',
                subject: "Build Restored: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                body: 'Le build est de nouveau stable (SUCCESS).'
            )
        }
    } 
}